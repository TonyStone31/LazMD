  end
  object edAlt: TEdit
    Left = 16
    Top = 102
    Width = 528
    Height = 30
    TabOrder = 2
  end
  object lblTitle: TLabel
    Left = 16
    Top = 144
    Caption = 'Title (optional)'
    FocusControl = edTitle
  end
  object edTitle: TEdit
    Left = 16
    Top = 166
    Width = 528
    Height = 30
    TabOrder = 3
  end
  object chkRelative: TCheckBox
    Left = 16
    Top = 208
    Width = 528
    Height = 24
    Caption = 'Use a path relative to this document'
