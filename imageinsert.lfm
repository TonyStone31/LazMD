  end
  object edFolder: TEdit
    Left = 16
    Top = 266
    Width = 528
    Height = 30
    Text = 'assets'
    TabOrder = 6
    OnChange = SourceChange
  end
  object lblPath: TLabel
    Left = 16
    Top = 450
    Caption = 'Image path in Markdown'
