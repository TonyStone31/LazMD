object frmImageInsert: TfrmImageInsert
  Left = 10
  Height = 572
  Top = 10
  Width = 560
  BorderStyle = bsDialog
  Caption = 'Insert image'
  ClientHeight = 572
  ClientWidth = 560
  Position = poOwnerFormCenter
  ActiveControl = edSource
  object lblSource: TLabel
    Left = 16
    Top = 16
    Caption = 'Picture file or URL'
    FocusControl = edSource
  end
  object edSource: TEdit
    Left = 16
    Top = 38
    Width = 428
    Height = 30
    TabOrder = 0
    OnChange = SourceChange
  end
  object btnBrowse: TButton
    Left = 452
    Top = 38
    Width = 92
    Height = 30
    Caption = '&Browse...'
    TabOrder = 1
    OnClick = BrowseClick
  end
  object lblAlt: TLabel
    Left = 16
    Top = 80
    Caption = 'Alternative text (describe the picture)'
