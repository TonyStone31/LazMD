  object dlgPicture: TOpenDialog
    Title = 'Choose a picture'
    Filter = 'Pictures|*.png;*.jpg;*.jpeg;*.gif;*.bmp;*.webp;*.ico|All files|*'
    Options = [ofFileMustExist, ofEnableSizing, ofViewDetail]
